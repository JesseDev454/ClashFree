# Local Docker Postgres (docker compose up db)
DATABASE_URL=postgresql+psycopg://clashfree:clashfree@127.0.0.1:5433/clashfree

# Neon PostgreSQL — paste the connection string from the Neon console.
# Either the pooled or direct URL works; Alembic should use a direct (non-pooler) URL.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
SESSION_SECRET=clashfree-dev-session-secret-change-me
AUTH_DEBUG=true
SEED_PASSWORD=ClashFree!dev
COOKIE_SECURE=false
APP_ORIGIN=http://127.0.0.1:5173
