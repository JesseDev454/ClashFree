# ClashFree environment template
# Copy the backend block to backend/.env and the frontend line to frontend/.env

# Backend — local Docker Postgres (docker compose up -d db)
DATABASE_URL=postgresql+psycopg://clashfree:clashfree@127.0.0.1:5433/clashfree
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
SESSION_SECRET=clashfree-dev-session-secret-change-me
AUTH_DEBUG=true
SEED_PASSWORD=ClashFree!dev
COOKIE_SECURE=false
APP_ORIGIN=http://127.0.0.1:5173

# Backend — Neon PostgreSQL (replace the URL above when you have a project)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Frontend — empty so Vite proxies /api and /health onto the same origin as the UI.
VITE_API_BASE_URL=
